#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Patient {
    int id;
    char name[50];
    float weight;
    float height;
    float bmi;
    struct Patient *left, *right;
};

// Create a new patient node
struct Patient* createPatient(int id, char name[], float weight, float height) {
    struct Patient* newNode = (struct Patient*)malloc(sizeof(struct Patient));

    newNode->id = id;
    strcpy(newNode->name, name);
    newNode->weight = weight;
    newNode->height = height;

    // BMI Formula
    newNode->bmi = weight / (height * height);

    newNode->left = newNode->right = NULL;

    return newNode;
}

// Insert patient into Binary Search Tree
struct Patient* insertPatient(struct Patient* root, int id, char name[], float weight, float height) {

    if (root == NULL) {
        return createPatient(id, name, weight, height);
    }

    if (id < root->id) {
        root->left = insertPatient(root->left, id, name, weight, height);
    } else {
        root->right = insertPatient(root->right, id, name, weight, height);
    }

    return root;
}

// Display patient records
void displayPatients(struct Patient* root) {

    if (root != NULL) {
        displayPatients(root->left);

        printf("\nPatient ID   : %d", root->id);
        printf("\nPatient Name : %s", root->name);
        printf("\nWeight       : %.2f kg", root->weight);
        printf("\nHeight       : %.2f m", root->height);
        printf("\nBMI          : %.2f", root->bmi);

        // BMI Status
        if (root->bmi < 18.5)
            printf("\nHealth Status: Underweight\n");
        else if (root->bmi >= 18.5 && root->bmi < 25)
            printf("\nHealth Status: Normal\n");
        else if (root->bmi >= 25 && root->bmi < 30)
            printf("\nHealth Status: Overweight\n");
        else
            printf("\nHealth Status: Obese\n");

        printf("\n-----------------------------\n");

        displayPatients(root->right);
    }
}

int main() {

    struct Patient* root = NULL;

    int choice, id;
    char name[50];
    float weight, height;

    while (1) {

        printf("\n===== HEALTH MONITORING SYSTEM =====\n");
        printf("1. Add Patient\n");
        printf("2. Display Patients\n");
        printf("3. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {

            case 1:
                printf("\nEnter Patient ID: ");
                scanf("%d", &id);

                printf("Enter Patient Name: ");
                scanf("%s", name);

                printf("Enter Weight (kg): ");
                scanf("%f", &weight);

                printf("Enter Height (m): ");
                scanf("%f", &height);

                root = insertPatient(root, id, name, weight, height);

                printf("\nPatient Added Successfully!\n");
                break;

            case 2:
                printf("\n===== PATIENT RECORDS =====\n");
                displayPatients(root);
                break;

            case 3:
                printf("\nExiting Program...\n");
                exit(0);

            default:
                printf("\nInvalid Choice!\n");
        }
    }

    return 0;
}
